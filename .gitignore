# pyenv
#   For a library or app, you might want to share your .python-version.
#   Only uncomment if you are using pyenv.
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git.
#   However, in case of collaboration, if others have different platform/python version,
#   uncomment this, and remove Pipfile.lock from git.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains exact signatures.
#   Uncomment if you want to avoid locking conflicts.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains exact signatures.
#pdm.lock

